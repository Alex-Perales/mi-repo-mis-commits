#!/bin/sh
# commit-msg hook — elimina cualquier rastro de atribucion a Claude Code
# de los mensajes de commit, como red de seguridad ademas de la
# configuracion de settings.json de Claude Code.
#
# Se ejecuta automaticamente en cada "git commit". Si Claude Code (u otra
# herramienta) agrego lineas como:
#   🤖 Generated with [Claude Code](https://claude.com/claude-code)
#   Co-Authored-By: Claude <noreply@anthropic.com>
# este hook las borra antes de que el commit quede grabado.

MSG_FILE="$1"

if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  exit 0
fi

TMP_FILE="${MSG_FILE}.tmp"

# 1) Quita las lineas de atribucion (comparacion insensible a mayusculas
#    hecha a mano, para que funcione igual en GNU awk, BSD awk y el awk
#    que trae Git for Windows).
awk '
{
  line = $0
  low = tolower(line)
  if (index(low, "generated with claude code") > 0) next
  if (index(low, "generated with [claude code]") > 0) next
  if (index(low, "co-authored-by:") > 0 && index(low, "claude") > 0) next
  print line
}
' "$MSG_FILE" > "$TMP_FILE"

# 2) Quita lineas en blanco sobrantes que hayan quedado al final del mensaje
awk '
{ lines[NR] = $0 }
END {
  n = NR
  while (n > 0 && lines[n] ~ /^[ \t]*$/) n--
  for (i = 1; i <= n; i++) print lines[i]
}
' "$TMP_FILE" > "$MSG_FILE"

rm -f "$TMP_FILE"

exit 0
